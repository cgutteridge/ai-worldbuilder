  "types": {
    "red_clay_tile": {
      "slope": "pitched",
      "family": "cinnabar_brick",
      "alternates": ["cut_copper", "brick", "mud_brick"],
      "note": "Red or orange-red clay tile or pantile, shown as cinnabar brick for its deep red brick-course look (owner choice: by look, not by name); cut_copper for a brighter orange tile, brick for a duller red one, mud_brick for an older, browner one."
    },
    "grey_slate": {
      "slope": "pitched",
      "family": "deepslate_brick",
      "alternates": ["deepslate_tile", "tuff_brick", "polished_deepslate"],
      "note": "Dark blue-grey natural or fibre-cement slate in neat courses, shown as deepslate brick for its dark brick-course look (owner choice: by look, not by name); deepslate_tile, tuff_brick or polished_deepslate for a paler slate."
    },
    "grey_tile": {
      "slope": "pitched",
      "family": "stone_brick",
      "alternates": ["andesite", "tuff"],
      "note": "Mid to light grey concrete tile or weathered slate; paler than grey_slate."
    },
    "brown_tile": {
      "slope": "pitched",
      "family": "mud_brick",
      "alternates": ["spruce", "dark_oak"],
      "note": "Brown, weathered or moss-darkened tile; dark_oak for the darkest."
    },
    "weathered_copper": {
      "slope": "pitched",
      "family": "weathered_cut_copper",
      "alternates": ["oxidized_cut_copper", "cut_copper"],
      "note": "Green copper or zinc-like sheet; oxidized_cut_copper for a bluer verdigris, cut_copper for new orange copper. Generic: never tied to a place."
    },
    "flat_deck": {
      "slope": "flatish",
      "family": "smooth_stone",
      "alternates": ["light_gray_concrete", "gray_concrete"],
      "note": "Flat or near-flat membrane, felt or gravel deck. No triad needed. Thatch has no vanilla triad and is left out."
    }
